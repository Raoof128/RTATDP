# Example environment variables for development
# Copy this to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=threat-detection-consumer
KAFKA_COMPRESSION_TYPE=snappy

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_DEFAULT_TTL=3600

# Database
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=threat_detection
DB_USERNAME=detector
DB_PASSWORD=detector_password
DB_POOL_SIZE=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# Models
MODEL_ENSEMBLE_MODELS_PATH=models/ensemble
MODEL_ANOMALY_MODELS_PATH=models/anomaly
MODEL_THREAT_THRESHOLD=0.85
MODEL_ANOMALY_THRESHOLD=1.0

# SIEM Integration (optional)
# SIEM_SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector
# SIEM_SPLUNK_HEC_TOKEN=your-hec-token-here
# SIEM_SPLUNK_INDEX=security
# SIEM_THEHIVE_URL=http://thehive.example.com:9000
# SIEM_THEHIVE_API_KEY=your-api-key-here
SIEM_AUTO_CREATE_CASES=true
SIEM_CASE_SEVERITY_THRESHOLD=high

# Performance
PERF_MAX_EVENTS_PER_SECOND=500000
PERF_BATCH_SIZE=128
PERF_MAX_LATENCY_MS=100
PERF_ENABLE_CACHING=true

# Monitoring
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_STRUCTURED_LOGGING=true
MONITORING_LOG_FORMAT=json
